---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderMedia from "../components/PlaceholderMedia.astro";
import { categoryHref, getCategory } from "../data/products";

/* Hero altındaki kart şeridi. Şablonun şeridi 3 kolondur: iki içerik kartı
   ve sağda koyu panel. Kartlar bu yüzden ikiyle sınırlı. */
const featuredSlugs = ["tasiyici-sistemler", "roll-form-ve-mekik-arabasi"];

const featured = featuredSlugs
	.map((slug) => getCategory(slug))
	.filter((category): category is NonNullable<typeof category> => Boolean(category));
---

<BaseLayout
	title="Makinend | Endüstriyel Mühendislik ve Özel Makine İmalatı"
	description="Konveyör ve taşıma sistemleri, roll form hatları, özel makineler, çelik konstrüksiyonlar ve kalıplar. İhtiyacı analiz ediyor, mühendisliğini yapıyor ve sahada çalışan bir sisteme dönüştürüyoruz."
>
	<section class="hero industrial-surface">
		<div class="container hero-inner">
			<h1 class="hero-title">
				Mühendislikten<br />
				çalışan sisteme
			</h1>

			<p class="hero-text">
				Taşıma sistemlerinden roll form hatlarına, özel makinelerden çelik
				konstrüksiyonlara kadar; ihtiyacı ve prosesi analiz ediyor,
				mühendisliğini yapıyor ve sahada çalışan bir sisteme dönüştürüyoruz.
			</p>

			<div class="hero-actions">
				<a href="/iletisim" class="btn btn-primary">İletişim</a>
				<a href="/hakkimizda" class="btn btn-ghost">Hakkımızda</a>
			</div>
		</div>
	</section>

	<section class="band-section">
		<div class="container">
			<div class="band">
				{
					featured.map((category) => (
						<article class="card">
							<div class="card-media">
								<PlaceholderMedia />
							</div>
							<div class="card-body">
								<h3 class="card-title">{category.title}</h3>
								<p class="card-text">{category.intro}</p>
								<a href={categoryHref(category)} class="card-link link-small">
									İncele
								</a>
							</div>
						</article>
					))
				}

				<article class="card card-dark">
					<div class="card-body">
						<h3 class="card-dark-title">
							Projeler ve<br />
							referanslar
						</h3>
						<p class="card-dark-text">
							Taşıma hatları, roll form sistemleri, kırma ve ayrıştırma
							tesisleri ile prosese özel makinelerde üstlendiğimiz işler.
						</p>
						<a href="/projeler" class="card-dark-link link-small">Projelere git</a>
					</div>
				</article>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* Hero ölçüleri şablondan: 790px yükseklik, başlık üstten 180px,
	   metin bloğu 540px, başlık-metin 30px, metin-buton 50px. */

	.hero {
		display: flex;
		align-items: flex-start;
		min-height: clamp(34rem, 62vw, 49.375rem);
		padding-top: clamp(3.5rem, 14vw, 11.25rem);
		padding-bottom: 8.75rem;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
	}

	.hero-title {
		max-width: 33.75rem;
		color: var(--color-text-inverse);
	}

	.hero-text {
		max-width: 33.75rem;
		margin-top: 1.875rem;
		color: var(--color-text-inverse-muted);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 3.125rem;
	}

	/* Kart şeridi: hero'nun alt kenarına biner. */

	/* Hero konumlandırılmış olduğu için şerit kendi katmanına alınır;
	   aksi halde hero, kartların binen kısmının üstüne boyanır. */
	.band-section {
		position: relative;
		z-index: 1;
		padding-bottom: var(--space-section);
	}

	.band {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 3.75rem; /* 60px, şablonun kolon aralığı */
		margin-top: -8.75rem; /* 140px hero'ya biner */
	}

	.card {
		display: flex;
		flex-direction: column;
		background: var(--color-surface);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
	}

	.card-media {
		border-bottom: 3px solid var(--color-copper);
	}

	.card-body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1.875rem; /* 30px */
	}

	/* Kart yükseklikleri eşit kalsın diye tanıtım metni kırpılır. */
	.card-text {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 4;
		overflow: hidden;
		margin-top: 0.625rem; /* 10px */
		color: var(--color-text-muted);
	}

	/* Başlıklar farklı satır sayısına çıksa da linkler aynı hizada kalır. */
	.card-link {
		align-self: flex-start;
		margin-top: auto;
		padding-top: 1.4rem;
		padding-bottom: 0.15rem;
		border-bottom: 1px solid var(--color-copper);
		color: var(--color-copper);
		transition: color var(--transition);
	}

	.card-link:hover {
		color: var(--color-charcoal);
		border-color: var(--color-charcoal);
	}

	/* Koyu kart */

	.card-dark {
		background: var(--color-charcoal-panel);
	}

	.card-dark-title {
		color: var(--color-copper);
	}

	.card-dark-text {
		margin-top: 0.625rem;
		color: var(--color-text-inverse-muted);
	}

	.card-dark-link {
		align-self: flex-start;
		margin-top: auto;
		padding-top: 1.4rem;
		color: var(--color-text-inverse);
		border-bottom: 1px solid rgba(255, 255, 255, 0.4);
		transition:
			color var(--transition),
			border-color var(--transition);
	}

	.card-dark-link:hover {
		color: var(--color-copper-bright);
		border-color: var(--color-copper-bright);
	}

	@media (max-width: 68rem) {
		.band {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2rem;
		}
	}

	@media (max-width: 40rem) {
		.hero {
			padding-bottom: clamp(3rem, 10vw, 5rem);
		}

		.band {
			grid-template-columns: 1fr;
			margin-top: 0;
			padding-top: var(--space-section);
		}

		.hero-actions .btn {
			flex: 1 1 12rem;
		}
	}
</style>
