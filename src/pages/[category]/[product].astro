---
import PageShell from "../../components/PageShell.astro";
import LinkCards from "../../components/LinkCards.astro";
import {
	breadcrumbForProduct,
	productCategories,
	productHref,
	relatedProducts,
	type Product,
	type ProductCategory,
} from "../../data/products";

export function getStaticPaths() {
	return productCategories.flatMap((category) =>
		category.children.map((product) => ({
			params: { category: category.slug, product: product.slug },
			props: { category, product },
		})),
	);
}

const { category, product } = Astro.props as { category: ProductCategory; product: Product };
const related = relatedProducts(category, product);
---

<PageShell
	title={product.title}
	description={product.intro}
	eyebrow={category.title}
	intro={product.intro}
	image={`/images/home/cat-${category.slug}.webp`}
	crumbs={breadcrumbForProduct(category, product)}
>
	<div class="pending">
		<h2>İçerik hazırlanıyor</h2>
		<p>Teknik özellikler, kullanım alanları ve galeri yakında burada olacak.</p>
	</div>

	{
		related.length > 0 && (
			<LinkCards
				heading="İlgili çözümler"
				items={related.map((item) => ({
					title: item.title,
					text: item.intro,
					href: productHref(category, item),
				}))}
			/>
		)
	}
</PageShell>

<style>
	.pending {
		max-width: 36rem;
		margin-bottom: var(--space-section);
		padding: 2rem 2.5rem;
		border: 1px solid var(--color-border);
		border-top: 3px solid var(--color-copper);
		color: var(--color-text-muted);
	}

	.pending h2 {
		margin-bottom: 0.5rem;
		font-size: 1.5rem;
	}
</style>
