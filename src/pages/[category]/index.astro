---
import PageShell from "../../components/PageShell.astro";
import LinkCards from "../../components/LinkCards.astro";
import {
	breadcrumbForCategory,
	categoryHref,
	productCategories,
	productHref,
	productMedia,
	type ProductCategory,
} from "../../data/products";

export function getStaticPaths() {
	return productCategories.map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props as { category: ProductCategory };
const others = productCategories.filter((item) => item.slug !== category.slug);
const lead = category.children.map((product) => productMedia(product)).find((media) => media.render);
---

<PageShell
	title={category.title}
	description={category.intro}
	eyebrow="Ürün grubu"
	intro={category.intro}
	image={`/images/home/cat-${category.slug}.webp`}
	crumbs={breadcrumbForCategory(category)}
	bare
>
	<section class="cat-intro">
		<div class="container cat-intro-grid">
			<div data-reveal>
				<span class="cat-kicker">Yaklaşımımız</span>
				<h2 class="cat-title">Doğru sistem, doğru mühendislik</h2>
				{category.description?.map((paragraph) => <p>{paragraph}</p>)}
				<dl class="cat-stats">
					<div>
						<dt>Çözüm</dt>
						<dd>{String(category.children.length).padStart(2, "0")}</dd>
					</div>
					<div>
						<dt>Kapsam</dt>
						<dd>Tasarım → devreye alma</dd>
					</div>
				</dl>
			</div>
			{
				lead?.render && (
					<div class="cat-render" data-reveal="right">
						<img src={lead.render} alt="" width="1100" height="800" decoding="async" />
					</div>
				)
			}
		</div>
	</section>

	<section class="cat-list">
		<div class="container">
			<LinkCards
				heading="Çözümler"
				items={category.children.map((product) => {
					const media = productMedia(product);
					return {
						title: product.title,
						text: product.intro,
						href: productHref(category, product),
						image: media.gallery[0] ?? media.hero,
					};
				})}
			/>
		</div>
	</section>

	<section class="cat-others">
		<div class="container">
			<span class="cat-kicker">Diğer ürün grupları</span>
			<ul class="cat-others-list">
				{
					others.map((item) => (
						<li>
							<a href={categoryHref(item)}>
								<img src={`/images/home/cat-${item.slug}.webp`} alt="" width="480" height="320" loading="lazy" decoding="async" />
								<span>{item.title}</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</PageShell>

<style>
	.cat-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-nav);
		font-size: 12px;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: var(--color-copper);
	}

	.cat-kicker::before {
		content: "";
		width: 1.75rem;
		height: 2px;
		background: currentColor;
	}

	.cat-intro {
		padding-block: var(--space-section);
	}

	.cat-intro-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: center;
	}

	.cat-title {
		margin: 0.75rem 0 1.25rem;
		font-size: clamp(1.75rem, 3.2vw, 2.5rem);
	}

	.cat-intro p {
		margin-top: 1rem;
		color: var(--color-text-muted);
	}

	.cat-stats {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 2rem 0 0;
	}

	.cat-stats > div {
		padding: 1.1rem 1.5rem;
		border: 1px solid var(--color-border);
		border-top: 3px solid var(--color-copper);
	}

	.cat-stats dt {
		font-family: var(--font-nav);
		font-size: 11px;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.cat-stats dd {
		margin: 0.25rem 0 0;
		font-family: var(--font-heading);
		font-size: 1.375rem;
		font-weight: 700;
		color: var(--color-charcoal);
	}

	.cat-render {
		position: relative;
		aspect-ratio: 4 / 3.2;
		background:
			radial-gradient(circle at 55% 45%, rgba(178, 105, 40, 0.22), transparent 62%),
			var(--color-charcoal-deep);
	}

	.cat-render img {
		width: 100%;
		height: 100%;
		padding: 8%;
		object-fit: contain;
		filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.45));
	}

	.cat-list {
		padding-block: var(--space-section);
		background: #f6f3ef;
	}

	.cat-others {
		padding-block: clamp(3rem, 6vw, 4.5rem);
	}

	.cat-others-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
		gap: 1rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.cat-others-list a {
		position: relative;
		display: block;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		text-decoration: none;
		background: var(--color-charcoal);
	}

	.cat-others-list img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.55;
		transition:
			transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
			opacity 0.4s ease;
	}

	.cat-others-list span {
		position: absolute;
		left: 1rem;
		right: 1rem;
		bottom: 0.9rem;
		font-family: var(--font-heading);
		font-weight: 700;
		text-transform: uppercase;
		line-height: 1.2;
		color: #fff;
	}

	.cat-others-list a::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 3px;
		background: var(--color-copper);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.5s cubic-bezier(0.7, 0, 0.2, 1);
	}

	.cat-others-list a:hover img {
		transform: scale(1.08);
		opacity: 0.8;
	}

	.cat-others-list a:hover::after {
		transform: scaleX(1);
	}

	@media (max-width: 60rem) {
		.cat-intro-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
