---
import { mainNav, site } from "../data/site";
import { productCategories, productHref } from "../data/products";

const currentPath = Astro.url.pathname;
const currentLang = site.languages[0];
const altLang = site.languages.find((language) => language.code !== currentLang.code);
const searchIndex = productCategories.flatMap((category) =>
	category.children.map((product) => ({
		title: product.title,
		href: productHref(category, product),
	})),
);

function isActive(href: string): boolean {
	return href === "/" ? currentPath === "/" : currentPath.startsWith(href);
}
---

{/* Üst satır ve menü şeridi kardeş elemanlar: şerit `sticky` ile tepeye
    yapışabilsin, logo satırı yukarı kayıp gitsin. */}
<header class="site-header">
	<div class="container header-top-inner">
		<a href="/" class="logo-link" aria-label={`${site.name} ana sayfa`}>
			<img src={site.logo} alt={`${site.name} logosu`} class="logo" />
		</a>

		<div class="header-aside">
			<a href={site.contact.phoneHref} class="header-phone">
				{site.contact.phone}
			</a>

			<div class="header-search">
				<button
					type="button"
					class="header-icon-btn"
					aria-label="Ara"
					aria-expanded="false"
					aria-controls="header-search-panel"
					data-search-toggle
				>
					<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
						<path d="M16 16l5 5" fill="none" stroke="currentColor" stroke-width="1.7"></path>
					</svg>
				</button>
				<div id="header-search-panel" class="header-search-panel" hidden>
					<label class="visually-hidden" for="header-search-input">Site içi arama</label>
					<input
						id="header-search-input"
						class="header-search-input"
						type="search"
						placeholder="Ürün ara"
						autocomplete="off"
						data-search-input
					/>
					<ul class="header-search-results" data-search-results></ul>
				</div>
			</div>

			<div class="header-lang">
				<button
					type="button"
					class="header-lang-btn"
					aria-expanded="false"
					aria-haspopup="listbox"
					aria-controls="header-lang-menu"
					aria-label="Dil seçimi"
					data-lang-toggle
				>
					{altLang?.label ?? "EN"}
				</button>
				<ul id="header-lang-menu" class="header-lang-menu" hidden>
					{
						site.languages.map((language) => (
							<li>
								{
									language.code === currentLang.code ? (
										<span class="header-lang-item is-current" aria-current="true">
											{language.label}
										</span>
									) : (
										<span class="header-lang-item is-soon" title="İngilizce sürüm yakında">
											{language.label}
										</span>
									)
								}
							</li>
						))
					}
				</ul>
			</div>

			<a href="/iletisim" class="header-cta"><span>Teklif Al</span></a>

			<button
				type="button"
				class="menu-toggle"
				aria-label="Menüyü aç"
				aria-expanded="false"
				aria-controls="mobile-nav"
				data-menu-toggle
			>
				<span class="menu-bar"></span>
				<span class="menu-bar"></span>
				<span class="menu-bar"></span>
			</button>
		</div>
	</div>

	<nav id="mobile-nav" class="nav-mobile" aria-label="Mobil menü" hidden>
		<ul class="nav-mobile-list">
			{
				mainNav.map((item) =>
					item.href ? (
						<li>
							<a href={item.href} class="nav-mobile-link">
								{item.label}
							</a>
						</li>
					) : (
						<li>
							<span class="nav-mobile-label">{item.label}</span>
							<ul class="nav-mobile-sub">
								{productCategories.flatMap((category) =>
									category.children.map((product) => (
										<li>
											<a
												href={productHref(category, product)}
												class="nav-mobile-link"
											>
												{product.title}
											</a>
										</li>
									)),
								)}
							</ul>
						</li>
					),
				)
			}
		</ul>
	</nav>
</header>

<nav class="header-nav" aria-label="Ana menü">
	<div class="container">
		<ul class="nav-list">
			{
				mainNav.map((item) => (
					<li class:list={["nav-item", { "has-menu": !item.href }]}>
						{
							item.href ? (
								<a
									href={item.href}
									class="nav-link"
									aria-current={isActive(item.href) ? "page" : undefined}
								>
									{item.label}
								</a>
							) : (
								<button
									type="button"
									class="nav-link nav-trigger"
									aria-expanded="false"
									aria-haspopup="true"
									aria-controls="products-menu"
								>
									{item.label}
								</button>
							)
						}

						{
							!item.href && (
								<div id="products-menu" class="nav-dropdown" hidden>
									<ul class="nav-dropdown-list">
										{productCategories.flatMap((category) =>
											category.children.map((product) => (
												<li>
													<a
														href={productHref(category, product)}
														class="nav-dropdown-link"
													>
														{product.title}
													</a>
												</li>
											)),
										)}
									</ul>
								</div>
							)
						}
					</li>
				))
			}
		</ul>
	</div>
</nav>

<script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />

<script>
	const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
	const panel = document.getElementById("mobile-nav");
	const trigger = document.querySelector<HTMLButtonElement>(".nav-trigger");
	const dropdown = document.getElementById("products-menu");
	const item = trigger?.closest(".nav-item");
	const searchToggle = document.querySelector<HTMLButtonElement>("[data-search-toggle]");
	const searchPanel = document.getElementById("header-search-panel");
	const searchInput = document.querySelector<HTMLInputElement>("[data-search-input]");
	const searchResults = document.querySelector<HTMLUListElement>("[data-search-results]");
	const langToggle = document.querySelector<HTMLButtonElement>("[data-lang-toggle]");
	const langMenu = document.getElementById("header-lang-menu");
	const searchSource = document.getElementById("search-index");
	const catalog: { title: string; href: string }[] = searchSource
		? JSON.parse(searchSource.textContent || "[]")
		: [];

	toggle?.addEventListener("click", () => {
		const open = toggle.getAttribute("aria-expanded") === "true";

		toggle.setAttribute("aria-expanded", String(!open));
		toggle.setAttribute("aria-label", open ? "Menüyü aç" : "Menüyü kapat");
		panel?.toggleAttribute("hidden", open);
	});

	function setMenu(open: boolean) {
		trigger?.setAttribute("aria-expanded", String(open));
		dropdown?.toggleAttribute("hidden", !open);
	}

	function setSearch(open: boolean) {
		searchToggle?.setAttribute("aria-expanded", String(open));
		searchPanel?.toggleAttribute("hidden", !open);
		if (open) {
			searchInput?.focus();
			renderResults(searchInput?.value ?? "");
		}
	}

	function setLang(open: boolean) {
		langToggle?.setAttribute("aria-expanded", String(open));
		langMenu?.toggleAttribute("hidden", !open);
	}

	function renderResults(query: string) {
		if (!searchResults) return;

		const needle = query.trim().toLocaleLowerCase("tr");
		const matches = needle
			? catalog.filter((entry) => entry.title.toLocaleLowerCase("tr").includes(needle))
			: catalog;

		searchResults.replaceChildren(
			...matches.slice(0, 8).map((entry) => {
				const li = document.createElement("li");
				const link = document.createElement("a");
				link.href = entry.href;
				link.className = "header-search-link";
				link.textContent = entry.title;
				li.append(link);
				return li;
			}),
		);
	}

	item?.addEventListener("mouseenter", () => setMenu(true));
	item?.addEventListener("mouseleave", () => setMenu(false));
	trigger?.addEventListener("click", () => {
		setMenu(trigger.getAttribute("aria-expanded") !== "true");
	});
	trigger?.addEventListener("keydown", (event) => {
		if (event.key === "Escape") setMenu(false);
	});

	searchToggle?.addEventListener("click", () => {
		setSearch(searchToggle.getAttribute("aria-expanded") !== "true");
		setLang(false);
	});
	searchInput?.addEventListener("input", () => renderResults(searchInput.value));

	langToggle?.addEventListener("click", () => {
		setLang(langToggle.getAttribute("aria-expanded") !== "true");
		setSearch(false);
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") {
			setSearch(false);
			setLang(false);
			setMenu(false);
		}
	});
</script>

<style>
	.site-header {
		position: relative;
		z-index: 40;
		background: var(--color-surface);
		font-family: var(--font-nav);
	}

	/* Üst satır: logo ve iletişim aksiyonu */

	.header-top-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 6.3125rem; /* 101px, şablonun üst satırı */
	}

	.logo-link {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.logo {
		display: block;
		width: 12.25rem;
		height: auto;
	}

	.header-aside {
		display: flex;
		align-items: center;
		gap: 1.15rem;
	}

	.header-phone {
		font-family: var(--font-heading);
		font-size: 13px;
		font-weight: 500;
		text-transform: uppercase;
		color: var(--color-nav);
		text-decoration: none;
		-webkit-font-smoothing: auto;
		transition: color var(--transition);
	}

	.header-phone:hover {
		color: var(--color-copper);
	}

	.header-icon-btn,
	.header-lang-btn {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-nav);
		cursor: pointer;
		-webkit-font-smoothing: auto;
	}

	.header-icon-btn svg {
		width: 18px;
		height: 18px;
	}

	.header-icon-btn:hover,
	.header-lang-btn:hover,
	.header-icon-btn[aria-expanded="true"],
	.header-lang-btn[aria-expanded="true"] {
		color: var(--color-copper);
	}

	.header-search,
	.header-lang {
		position: relative;
	}

	.header-lang-btn {
		font-family: var(--font-nav);
		font-size: 11px;
		font-weight: 400;
		letter-spacing: 1px;
		line-height: 30px;
		text-transform: uppercase;
	}

	.header-search-panel,
	.header-lang-menu {
		position: absolute;
		top: calc(100% + 0.75rem);
		right: 0;
		z-index: 70;
		min-width: 16rem;
		background: var(--color-surface);
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
	}

	.header-lang-menu {
		min-width: 5.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.header-search-input {
		display: block;
		width: 100%;
		padding: 12px 16px 10px;
		border: 0;
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-body);
		font-size: 15px;
		color: var(--color-nav);
	}

	.header-search-input:focus {
		outline: none;
	}

	.header-search-results,
	.header-search-results li {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.header-search-link,
	.header-lang-item {
		display: block;
		padding: 12px 16px 10px;
		font-family: var(--font-nav);
		font-size: 11px;
		letter-spacing: 1px;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-nav);
		-webkit-font-smoothing: auto;
	}

	.header-search-link:hover,
	.header-lang-item.is-current {
		color: var(--color-copper);
	}

	.header-lang-item.is-soon {
		color: var(--color-text-muted);
		cursor: default;
	}

	/* Lightwire Get in touch: bakır katman yazının ARKASINDA durur,
	   hover'da soldan sağa çekilir. z-index: -1 kullanılmaz; aksi halde
	   dolgu header'ın beyazının arkasına düşüp anında kaybolur. */
	.header-cta {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 8.25rem;
		padding: 10px 28px 8px;
		border: 0;
		background: transparent;
		font-family: var(--font-heading);
		font-size: 13px;
		font-weight: 500;
		line-height: 23px;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-text-inverse);
		white-space: nowrap;
		transition: color 0.45s ease;
	}

	.header-cta > span {
		position: relative;
		z-index: 1;
	}

	.header-cta::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 0;
		background: var(--color-copper);
		transform: scaleX(1);
		transform-origin: left center;
		transition: transform 0.45s ease;
	}

	.header-cta:hover {
		color: var(--color-copper);
	}

	.header-cta:hover::before {
		transform: scaleX(0);
	}

	/* Menü şeridi: sayfa kaydıkça tepeye yapışır. */

	.header-nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--color-surface);
		border-top: 1px solid var(--color-border-strong);
		box-shadow: 0 3px 3px rgba(0, 0, 0, 0.12);
		font-family: var(--font-nav);
	}

	.nav-list {
		display: flex;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav-item {
		position: relative;
		flex: 1;
		min-width: 0;
	}

	.nav-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		min-height: 2.3125rem; /* 37px */
		padding: 14px 0 12px;
		border: 0;
		border-right: 1px solid var(--color-border-strong);
		background: transparent;
		font-family: var(--font-nav);
		font-size: 11px;
		font-weight: 400;
		line-height: 11px;
		letter-spacing: 1px;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
		color: var(--color-nav);
		/* Lightwire `auto` kullanır; antialiased Coda 11px'i grileştirir. */
		-webkit-font-smoothing: auto;
		cursor: pointer;
		transition:
			color 0.3s,
			background-color 0.3s;
	}

	.nav-item:first-child .nav-link {
		border-left: 1px solid var(--color-border-strong);
	}

	/* Şablon: hover'da hücre tamamen vurgu rengine boyanır, yazı beyaz olur. */
	.nav-item:hover > .nav-link,
	.nav-item:focus-within > .nav-link,
	.nav-trigger[aria-expanded="true"] {
		color: var(--color-text-inverse);
		background: var(--color-copper);
	}

	/* Açılır liste: şablonun Home dropdown'u */

	.nav-dropdown {
		position: absolute;
		top: 100%;
		left: 0;
		z-index: 60;
		min-width: 100%;
		background: var(--color-surface);
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
	}

	.nav-dropdown-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav-dropdown-link {
		display: block;
		padding: 12px 20px 10px;
		font-family: var(--font-nav);
		font-size: 11px;
		font-weight: 400;
		line-height: 16px;
		letter-spacing: 1px;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-nav);
		white-space: nowrap;
		-webkit-font-smoothing: auto;
		transition: color 0.1s;
	}

	.nav-dropdown-link:hover {
		color: var(--color-copper);
	}

	/* Mobil */

	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 2.85rem;
		height: 2.85rem;
		padding: 0;
		border: 1px solid var(--color-border);
		background: none;
		cursor: pointer;
	}

	.menu-bar {
		display: block;
		width: 1.25rem;
		height: 2px;
		margin-inline: auto;
		background: var(--color-charcoal);
	}

	.nav-mobile {
		border-top: 1px solid var(--color-border);
	}

	.nav-mobile-list,
	.nav-mobile-sub {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav-mobile-list {
		padding: 0.5rem 0;
	}

	.nav-mobile-link,
	.nav-mobile-label {
		display: block;
		padding: 0.9rem clamp(1.25rem, 4vw, 2.5rem);
		font-family: var(--font-nav);
		font-size: 11px;
		font-weight: 400;
		letter-spacing: 1px;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-nav);
		-webkit-font-smoothing: auto;
	}

	.nav-mobile-label {
		color: var(--color-text-muted);
	}

	.nav-mobile-sub .nav-mobile-link {
		padding-left: clamp(2rem, 8vw, 3.5rem);
	}

	@media (max-width: 60rem) {
		.header-nav {
			display: none;
		}

		.menu-toggle {
			display: flex;
		}

		.logo {
			width: 10rem;
		}

		.header-top-inner {
			min-height: 5.25rem;
		}

		.site-header {
			position: sticky;
			top: 0;
			box-shadow: 0 3px 3px rgba(0, 0, 0, 0.12);
		}
	}

	@media (max-width: 34rem) {
		.header-phone {
			display: none;
		}
	}

	@media (min-width: 60.0625rem) {
		.nav-mobile {
			display: none;
		}
	}
</style>
