---
import { site } from "../data/site";

const year = new Date().getFullYear();

/* Faz 2'de bu kolon tam ürün ağacıyla site haritasına dönüşecek. */
const corporateLinks = [
	{ label: "Ana Sayfa", href: "/" },
	{ label: "Projeler", href: "/projeler" },
	{ label: "Hakkımızda", href: "/hakkimizda" },
	{ label: "İletişim", href: "/iletisim" },
];
---

<footer class="site-footer">
	<div class="container footer-inner">
		<div class="footer-col">
			<img src={site.logo} alt={`${site.name} logosu`} class="footer-logo" />
			<p class="footer-tagline">{site.tagline}</p>
			<nav class="footer-social" aria-label="Sosyal medya">
				{
					site.socials.map((item) => (
						<a
							href={item.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={item.label}
						>
							{item.id === "linkedin" && (
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z" />
								</svg>
							)}
							{item.id === "instagram" && (
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M12 7.2A4.8 4.8 0 1 0 16.8 12 4.81 4.81 0 0 0 12 7.2zm0 7.92A3.12 3.12 0 1 1 15.12 12 3.13 3.13 0 0 1 12 15.12zM17.88 6.96a1.12 1.12 0 1 1-1.12-1.12 1.12 1.12 0 0 1 1.12 1.12zM21.6 7.2a6.36 6.36 0 0 0-1.74-4.5A6.4 6.4 0 0 0 15.36 1H8.64A6.4 6.4 0 0 0 4.14 2.7 6.36 6.36 0 0 0 2.4 7.2v6.72a6.36 6.36 0 0 0 1.74 4.5A6.4 6.4 0 0 0 8.64 22.1h6.72a6.4 6.4 0 0 0 4.5-1.68 6.36 6.36 0 0 0 1.74-4.5zm-1.68 6.72a4.68 4.68 0 0 1-1.26 3.3 4.74 4.74 0 0 1-3.3 1.2H8.64a4.74 4.74 0 0 1-3.3-1.2 4.68 4.68 0 0 1-1.26-3.3V7.2a4.68 4.68 0 0 1 1.26-3.3A4.74 4.74 0 0 1 8.64 2.7h6.72a4.74 4.74 0 0 1 3.3 1.2 4.68 4.68 0 0 1 1.26 3.3z" />
								</svg>
							)}
							{item.id === "youtube" && (
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M23.5 6.2a3.05 3.05 0 0 0-2.15-2.16C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.35.44A3.05 3.05 0 0 0 .5 6.2 32 32 0 0 0 0 12a32 32 0 0 0 .5 5.8 3.05 3.05 0 0 0 2.15 2.16c1.85.44 9.35.44 9.35.44s7.5 0 9.35-.44a3.05 3.05 0 0 0 2.15-2.16A32 32 0 0 0 24 12a32 32 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12z" />
								</svg>
							)}
						</a>
					))
				}
			</nav>
		</div>

		<div class="footer-col">
			<h3 class="footer-heading">İletişim</h3>
			<ul class="footer-contact">
				{site.contact.addressLines.map((line) => <li>{line}</li>)}
				<li>
					<a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
				</li>
				<li>
					<a href={site.contact.phoneHref}>{site.contact.phone}</a>
				</li>
			</ul>
		</div>

		<div class="footer-col">
			<h3 class="footer-heading">Kurumsal</h3>
			<ul class="footer-links">
				{
					corporateLinks.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<div class="footer-bottom">
		<div class="container">
			<p class="footer-copy">&copy; {year} {site.name}</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: #f5f5f5;
		color: #4c4c4c;
		-webkit-font-smoothing: auto;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0;
		/* Container'ın 40px'i kolonları içeri kaçırıyor; Lightwire 15 + 30. */
		padding: 80px 15px 70px;
	}

	.footer-col {
		padding: 0 30px;
	}

	/* logo.png'de bol şeffaf pay var; object-fit ile wordmark kırpılır. */
	.footer-logo {
		display: block;
		width: 15.5rem;
		height: 3.375rem;
		margin-bottom: 0.75rem;
		object-fit: cover;
		object-position: center;
	}

	.footer-tagline {
		margin-top: 1.25rem;
		font-family: var(--font-body);
		font-size: 14px;
		font-weight: 400;
		line-height: 26px;
		color: #4c4c4c;
	}

	.footer-social {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
		margin-top: 20px;
	}

	.footer-social a {
		display: grid;
		place-items: center;
		width: 43px;
		height: 43px;
		border: 1px solid #828282;
		border-radius: 50%;
		color: #585858;
		text-decoration: none;
		transition:
			border-color var(--transition),
			color var(--transition);
	}

	.footer-social a:hover {
		border-color: var(--color-copper);
		color: var(--color-copper);
	}

	.footer-social svg {
		width: 15px;
		height: 15px;
		fill: currentColor;
	}

	.footer-heading {
		margin: 0 0 1.75rem;
		font-family: var(--font-heading);
		font-size: 26px;
		font-weight: 700;
		line-height: 1.1;
		text-transform: uppercase;
		color: #4c4c4c;
	}

	.footer-contact {
		margin: 0 0 0 19px;
		padding: 0;
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 400;
		line-height: 26px;
		color: #4c4c4c;
		list-style: square;
	}

	.footer-contact a {
		color: #4c4c4c;
		text-decoration: none;
	}

	.footer-contact a:hover {
		color: var(--color-copper);
	}

	/* Useful Resources: border-left omurga + her linkte 20px çentik. */
	.footer-links {
		margin: -5px 0 0;
		padding: 0;
		list-style: none;
		border-left: 1px solid #9c9c9c;
	}

	.footer-links a {
		position: relative;
		display: block;
		padding: 5px 0 5px 30px;
		font-family: var(--font-nav);
		font-size: 13px;
		font-weight: 400;
		line-height: 17px;
		letter-spacing: normal;
		text-transform: uppercase;
		text-decoration: none;
		color: #696969;
		-webkit-font-smoothing: auto;
	}

	.footer-links a::before {
		content: "";
		position: absolute;
		top: 13px;
		left: 0;
		width: 20px;
		height: 1px;
		background: #9c9c9c;
	}

	.footer-links a:hover {
		color: var(--color-copper);
	}

	.footer-bottom {
		border-top: 1px solid #cccccc;
	}

	.footer-copy {
		padding: 25px 20px 20px;
		font-family: var(--font-body);
		font-size: 12px;
		line-height: 20px;
		letter-spacing: 1px;
		color: #4c4c4c;
		text-align: center;
	}

	@media (max-width: 52rem) {
		.footer-inner {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 34rem) {
		.footer-inner {
			grid-template-columns: 1fr;
		}
	}
</style>
